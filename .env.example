# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
# Default: Local SQLite for zero-configuration local development & test execution
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/trace?schema=public"

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_key_min_32_chars
SESSION_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Optional: Email service configuration for password reset
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TRACE <noreply@trace.space>"
